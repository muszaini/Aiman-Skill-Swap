# SkillSwap Production Environment Variables
# Copy to .env for local or cloud deployment. NEVER commit .env to GitHub!

# Supabase PostgreSQL Connection URI (falls back to local SQLite skillswap.db if omitted)
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Supabase Auth Configuration (Never expose SUPABASE_SERVICE_ROLE_KEY in React / VITE_*)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Server Port
PORT=3000

# Backend-Only AI Provider Keys (NEVER expose in React / VITE_* browser variables)
GEMINI_API_KEY=
OPENAI_API_KEY=
